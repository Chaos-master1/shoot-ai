# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
# Anchored to repo root only — an unanchored "dist/"/"build/" also matched
# src/kawkab/web/dist/, silently excluding the built JS bundle from every
# commit (and therefore from the wheel). See CLAUDE.md P0 packaging notes.
/dist/
/build/
*.whl
*.spec.bak

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Application data (user data, never commit)
/data/sample_matches/*.mp4
# Runtime-written user data. The recruitment services (opponent profiles,
# scouting network, Transfermarkt cache) used to store inside the source
# tree (src/data/); they now write under the per-user appdata dir, but any
# stale checkout artifacts must never be committed.
/src/data/

# Node.js
node_modules/
test-results/
*.tsbuildinfo

# Frontend build output: intentionally NOT committed (it's generated by
# `node scripts/bundle-js.mjs` from scripts/frontend-manifest.json).
# It still has to ship in the wheel/installer -- that's handled by
# `[tool.hatch.build.targets.wheel] artifacts` in pyproject.toml, which
# force-includes gitignored generated files, plus a frontend-build step
# in release.yml before packaging. Do not commit compiled JS here; fix
# the build step instead if the shipped bundle is missing/stale.
src/kawkab/web/dist/
/data/sample_matches/*.mov
/data/sample_matches/*.avi
/data/models/*.pt
/data/models/*.onnx
/data/models/*.weights
/data/cache/
/data/exports/

# Sample videos (too large for git)
# /data/sample_football.mp4
# /data/real_match.mp4
data/*.mp4
data/*.mov
data/*.avi
!data/.gitkeep

# Logs
*.log
logs/

# Test coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Build artifacts
KawkabAI.spec.bak
*.exe
*.dmg
*.AppImage
/installer/

# Graphify (dev tool)
graphify-out/

# Large files
*.mp4
*.mov
*.avi
*.zip
*.tar.gz
*.7z

# ML model weights (downloaded at runtime, not committed)
*.pt
*.onnx
*.weights
*.pkl
*.joblib

# YOLO model files specifically
yolo11*.pt
yolov8*.pt

tracking_output/
tracking_output_*/
runs/
benchmark_results/
frame_sample_*.jpg
.hypothesis/

data/ground_truth/

# Local-only tool config (not project content) and scratch/generated data
.opencode/
.freebuff/
data/ball_detector/
data/soccernet/
data/pg_ordered.sql
data/build*.log
data/ball_eval_2min.json
