# Kawkab AI — Environment Configuration
# Copy this file to .env and fill in your values.
# Kawkab AI runs fully offline with no API keys required.
# Only fill in keys if you want external data providers.

# === Core Settings ===
KAWKAB_LANG=en              # Language: en or ar
KAWKAB_DEBUG=false           # Enable debug mode (verbose logging)
KAWKAB_DATA_DIR=             # Custom data directory (default: ~/Documents/KawkabAI/)

# === External Football Data APIs (optional) ===
# These are read-only public data providers for match/league info.
# Kawkab AI works 100% offline without any of these.

# Football-Data.org (https://www.football-data.org)
# Free tier: 10 requests/min, 1000/day
FOOTBALL_DATA_API_KEY=

# API-Football (https://www.api-football.com)
# Requires free registration
APIFOOTBALL_API_KEY=

# Bzzoiro (https://www.bzzoiro.com)
BZZOIRO_API_KEY=

# TheSportsDB (https://www.thesportsdb.com)
# Free tier works with no key at all (defaults to the public test key "123")
THESPORTSDB_API_KEY=

# === LLM Provider (optional, for analysis reports) ===
# Local: Ollama (default, runs on RTX 4070)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Remote: OpenAI-compatible (set API key if not using local Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# === Optional Service Flags ===
ENABLE_FACE_RECOGNITION=true     # Requires insightface + onnx<1.19
ENABLE_WEATHER_DETECTION=true    # Uses local CNN model
ENABLE_REALTIME_ANALYSIS=false   # Enable live video processing

# === Physics Engine (optional, for set-piece simulation) ===
KAWKAB_FLUIDX3D_PATH=            # Path to FluidX3D binary for physics sims
ENABLE_PHYSICS_SIM=false

# === Security ===
# Session timeout in minutes (0 = no timeout)
SESSION_TIMEOUT_MINUTES=0

# === Database (optional — SQLite is used by default, no setup needed) ===
# Set to switch the desktop app's StorageService to PostgreSQL instead of
# the default local SQLite file. Use plain postgresql:// (not the
# SQLAlchemy postgresql+asyncpg:// dialect form -- this is passed
# straight to asyncpg.connect(), which rejects the +asyncpg suffix).
# e.g. postgresql://kawkab:<password>@localhost:5432/kawkab
KAWKAB_DB_URL=

# Password embedded in KAWKAB_DB_URL above when deploying via
# docker-compose.yml or k8s/deployment.yaml -- both require this to be
# set explicitly (no default) rather than falling back to a guessable
# value.
KAWKAB_DB_PASSWORD=

# === Cloud / Team Server (optional — only needed to run `kawkab.cloud`,
# the multi-user FastAPI server for team collaboration; the desktop app
# never needs any of these) ===

# Required to start the cloud server at all — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters (auth.py refuses to start otherwise).
KAWKAB_JWT_SECRET=

# SQLite path for the cloud server's own metadata DB (users, teams, sessions).
# Default: ~/.kawkab/cloud.db
KAWKAB_CLOUD_DB=

# Client-side: URL of a running cloud server, for this desktop app's
# "sync to team" feature (cloud_sync_service.py).
KAWKAB_CLOUD_URL=

# Comma-separated list of allowed CORS origins for the cloud server's API.
# Default: https://app.kawkab.ai
KAWKAB_CORS_ORIGINS=

# Set to "1" to disable the cloud server's rate limiter — for tests only,
# never in production.
KAWKAB_RATE_LIMIT_DISABLE=

# Set to "1" ONLY when the cloud server is deployed behind a trusted
# reverse proxy that sets X-Real-IP / X-Forwarded-For itself (the shipped
# infrastructure/nginx.conf does) — the rate limiter will then key on the
# real client IP from those headers instead of the immediate TCP peer
# (which behind any proxy is just the proxy's own IP for every request,
# collapsing all users into one shared rate-limit bucket). Never enable
# this if the server is reachable directly, without a trusted proxy in
# front of it: those headers are plain HTTP headers a client can set
# themselves, letting them spoof their rate-limit identity.
KAWKAB_TRUST_PROXY_HEADERS=

# OAuth social login for the cloud server (optional; each provider is
# independently optional — leave blank to not offer that login method).
KAWKAB_GOOGLE_CLIENT_ID=
KAWKAB_GOOGLE_CLIENT_SECRET=
KAWKAB_GITHUB_CLIENT_ID=
KAWKAB_GITHUB_CLIENT_SECRET=
KAWKAB_APPLE_CLIENT_ID=
KAWKAB_APPLE_CLIENT_SECRET=

# HMAC key for tracking-pipeline checkpoint file integrity (resumable
# long-running video processing). Has a working default for local,
# single-user use; override only if you need checkpoints signed with a
# specific key (e.g. shared processing across machines).
KAWKAB_CKPT_SECRET=
